# ── Server ─────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
PUBLIC_URL=https://bridge.example.com
# Protects /api/*, /ghl/page-api/* (outside SSO) and setup routes. REQUIRED in production.
ADMIN_TOKEN=
# Signs OAuth state + GHL page sessions. Set a stable value so sessions survive restarts.
APP_SECRET=
# JSON-file persistence (omit for in-memory)
DATA_FILE=.data/state.json
# Expose /playground and /api/simulate*
SANDBOX=true
REQUIRE_SIGNATURES=true

# ── FSM webhook secrets (unset → ephemeral sandbox secret) ───────────────
JOBBER_WEBHOOK_SECRET=          # Jobber app client secret (X-Jobber-Hmac-SHA256)
JOBBER_ACCESS_TOKEN=            # OAuth token used to hydrate thin Jobber webhooks over GraphQL
HCP_WEBHOOK_SECRET=             # Housecall Pro webhook signing secret (Api-Signature / Api-Timestamp)
SERVICETITAN_WEBHOOK_SECRET=
FIELDEDGE_WEBHOOK_SECRET=
BUILDERTREND_WEBHOOK_SECRET=

# ── Business rules ────────────────────────────────────────────────────
HIGH_VALUE_THRESHOLD_CENTS=50000
REVIEW_ENABLED=true
REVIEW_MIN_SATISFACTION=4
REVIEW_COOLDOWN_DAYS=90
REVIEW_MIN_INVOICE_CENTS=0
REVIEW_DELAY_MINUTES=120
CRM_RETRY_ATTEMPTS=3
CRM_RETRY_BASE_DELAY_MS=250

# ── GoHighLevel ───────────────────────────────────────────────────────
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SSO_SECRET=                 # Marketplace app "Shared Secret" (Custom Page SSO)
GHL_ACTION_SECRET=              # appended as ?key= to trigger/action URLs
GHL_WEBHOOK_PUBLIC_KEY=         # PEM, \n-escaped, for x-wh-signature
GHL_PRIVATE_TOKEN=              # alternative to OAuth for a single sub-account
GHL_LOCATION_ID=
GHL_LOCATION_MAP=               # {"<fsmAccountId>":"<ghlLocationId>"}

# ── HubSpot ───────────────────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_APP_ID=
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=

# ── Pipedrive ─────────────────────────────────────────────────────────
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_PANEL_USER=
PIPEDRIVE_PANEL_PASSWORD=

# ── monday.com ────────────────────────────────────────────────────────
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_SIGNING_SECRET=
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

# ── Make ──────────────────────────────────────────────────────────────
MAKE_API_KEYS=                  # comma-separated
